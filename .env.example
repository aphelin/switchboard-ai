# ---------------------------------------------------------------------------
# Server (copy to server/.env.development and server/.env.production)
# ---------------------------------------------------------------------------

# PostgreSQL (the image must include pgvector: pgvector/pgvector:pg16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mini_ai_toolkit
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mini_ai_toolkit?schema=public

# Redis (use "redis" for Docker, "localhost" for local development)
REDIS_HOST=redis
REDIS_PORT=6379

# Pollinations API (image generation, and the default LLM provider)
# Get a key at https://pollinations.ai and paste it here
POLLINATIONS_API_KEY=your_pollinations_api_key

# Server
SERVER_PORT=4000
# Public origin of the API, used to build image URLs (defaults to http://localhost:SERVER_PORT)
SERVER_PUBLIC_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
# Where generated images are stored (local disk; mounted as a volume in Docker)
STORAGE_DIR=./storage

# Auth (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_random_32_plus_character_secret
# Origin the API runs on (defaults to SERVER_PUBLIC_URL)
BETTER_AUTH_URL=http://localhost:4000
# Per-user daily AI spending limit in USD (0 disables the limit)
USER_DAILY_BUDGET_USD=0.50
# Dev convenience: the first account created takes ownership of rows created before auth existed
AUTH_CLAIM_LEGACY_DATA=false

# Bring your own key: users can add OpenAI / Anthropic / Google keys to use those models.
# Keys are encrypted with this AES-256 key (32 random bytes, base64): openssl rand -base64 32
# Leave empty to offer only the included models. Changing it makes stored keys unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# LLM provider: any OpenAI-compatible API. Presets: pollinations | openai | groq | gemini | ollama | custom
# With "pollinations" the POLLINATIONS_API_KEY is reused and LLM_API_KEY can stay empty.
LLM_PROVIDER=pollinations
LLM_BASE_URL=
LLM_API_KEY=
# Main model for chat/agents and text generation; fast model for cheap tasks (prompt enhancement, titles)
LLM_MODEL=openai/gpt-5.4-mini
LLM_FAST_MODEL=openai/gpt-5.4-nano
# Optional pricing override, USD per 1M tokens: {"model-id":{"input":0.15,"output":0.6}}
LLM_PRICING_JSON=

# Optional fallback provider used when the primary one is down (not for 4xx errors)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Embeddings: "local" runs Xenova/bge-small-en-v1.5 in-process (free, downloaded once);
# "openai-compatible" calls a hosted API (EMBEDDING_BASE_URL/EMBEDDING_API_KEY).
# The model must produce 384 dimensions (see vector(384) in prisma/schema.prisma).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
TRANSFORMERS_CACHE_DIR=./.cache/transformers

# ---------------------------------------------------------------------------
# Client (copy to client/.env.development and client/.env.production)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
