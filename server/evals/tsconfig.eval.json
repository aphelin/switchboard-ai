{
  "extends": "../tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist/eval",
    "incremental": false
  },
  "include": [
    "../src/**/*",
    "../evals/**/*",
    "../generated/**/*"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../**/*.spec.ts",
    "../evals/mcp-smoke.ts",
    "../evals/auth-isolation.ts"
  ]
}
